<Window x:Class="SteamLibrarySize.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Library Size" Height="600" Width="760" MinHeight="400" MinWidth="560">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Scan" Command="{Binding ScanCommand}"
                    Padding="18,4" Margin="8,0,0,0" FontWeight="Bold"/>
            <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}"
                    Padding="10,4" Margin="8,0,0,0"/>
            <TextBox Text="{Binding SteamPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" IsReadOnly="False"/>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding Headline}" FontSize="22" FontWeight="Bold"
                   Margin="0,0,0,8"/>

        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <CheckBox DockPanel.Dock="Left" Content="Include DLC" IsChecked="{Binding IncludeDlc}"
                      VerticalAlignment="Center" IsEnabled="{Binding HasResults}"/>
            <Button DockPanel.Dock="Right" Content="Export CSV" Command="{Binding ExportCsvCommand}"
                    Padding="10,4" IsEnabled="{Binding HasResults}"/>
            <ProgressBar Value="{Binding ProgressValue}" Height="18" Margin="12,0"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
        </DockPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Apps}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                <DataGridTextColumn Header="Size (GB)" Width="110"
                    Binding="{Binding SizeGb, StringFormat={}{0:N1}, ConverterCulture=en-GB}"
                    SortMemberPath="SizeGb"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="{Binding StatusText}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="Gray"/>
    </Grid>
</Window>
